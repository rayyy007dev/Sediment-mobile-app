{
  "appId": "com.sediment.app",
  "appName": "Sediment",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#080919",
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "backgroundColor": "#080919",
      "style": "DARK",
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
